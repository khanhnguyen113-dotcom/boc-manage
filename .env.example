# =============================================================================
# BOC Control Tower — biến môi trường
# Copy sang `.env.local` (dev) hoặc cấu hình trong Dokploy (staging/production).
# KHÔNG commit `.env*`. `NEXT_PUBLIC_*` chỉ chứa giá trị công khai.
# =============================================================================

NODE_ENV=development
APP_NAME=BOC Control Tower
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi-VN

# -----------------------------------------------------------------------------
# Kho dữ liệu
# `local`    : file JSON, CHỈ dùng cho development (ADR-003). App từ chối chạy
#              production với giá trị này.
# `appwrite` : Appwrite TablesDB — bắt buộc cho staging/production.
# -----------------------------------------------------------------------------
DATA_DRIVER=local
LOCAL_DATA_FILE=.data/boc.json

# -----------------------------------------------------------------------------
# Phiên đăng nhập
# SESSION_SECRET phải đổi trước khi lên staging (tối thiểu 32 ký tự ngẫu nhiên):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# -----------------------------------------------------------------------------
SESSION_COOKIE_NAME=hh_boc_session
SESSION_SECRET=doi-gia-tri-nay-truoc-khi-len-staging
SESSION_MAX_AGE_SECONDS=28800

# Mật khẩu dùng chung cho tài khoản demo khi DATA_DRIVER=local.
LOCAL_DEV_PASSWORD=boc@2026

# -----------------------------------------------------------------------------
# Appwrite (bắt buộc khi DATA_DRIVER=appwrite)
# APPWRITE_SERVER_API_KEY chỉ tồn tại phía server — không bao giờ đặt vào NEXT_PUBLIC_*.
# -----------------------------------------------------------------------------
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=boc_control_tower
APPWRITE_SERVER_API_KEY=
# Alias tương thích Dokploy (không cần đặt nếu đã có APPWRITE_SERVER_API_KEY):
# APPWRITE_API_KEY=
# Có thể tách quyền trên Dokploy; nếu đặt, hai key này được ưu tiên hơn key dùng chung:
# APPWRITE_API_KEY_AUTH=   # scopes: users.read, users.write
# APPWRITE_API_KEY_DATA=   # scopes đọc/ghi TablesDB và Storage cần thiết
APPWRITE_BUCKET_ATTACHMENTS=boc_attachments
APPWRITE_BUCKET_IMPORTS=boc_imports
APPWRITE_BUCKET_EXPORTS=boc_exports

# Ghi de phan giai DNS cho DUNG mot hostname (ADR-017). Mac dinh TAT.
# Chi dung khi mang khong phan giai duoc endpoint Appwrite (vi du bi chan sslip.io/nip.io)
# va khong co quyen sua file hosts. Production KHONG dung — phai co DNS dung va HTTPS.
APPWRITE_RESOLVE_HOST=
APPWRITE_RESOLVE_IP=

# Chỉ dùng một lần với `npm run reset:users -- --execute --confirm=RESET-ALL-USERS`.
# Không lưu các giá trị này vào Git/Dokploy sau khi đã bootstrap super admin.
RESET_ADMIN_EMAIL=
RESET_ADMIN_PASSWORD=
RESET_ADMIN_NAME=Quản trị hệ thống BOC

# -----------------------------------------------------------------------------
# Tham số nghiệp vụ — TẤT CẢ đang chờ BOC chốt, xem NEED_CONFIRMATION.md.
# Giá trị ở đây là mặc định khi `system_settings` chưa có bản ghi tương ứng;
# admin đổi trên UI thì `system_settings` thắng.
# -----------------------------------------------------------------------------
# MON_SAT = loại Chủ nhật (giống NETWORKDAYS.INTL(...;11;...) của Sheet) · MON_FRI = 5 ngày
WORK_WEEK_MASK=MON_SAT
# Số ngày quy đổi giờ/tuần → giờ/ngày. Sheet dùng 5 dù tuần làm việc 6 ngày (mâu thuẫn B3).
CAPACITY_DAYS_PER_WEEK=5
DEFAULT_CAPACITY_HOURS_PER_DAY=8
# Sheet có cả 0.80 (danh mục) và 0.85 (báo cáo) — đang dùng 0.85 (mâu thuẫn B4).
NEAR_CAPACITY_THRESHOLD=0.85
DEADLINE_WARNING_BUSINESS_DAYS=7
# average = trung bình đều như Sheet (mặc định) · weighted = theo giờ, chỉ bật khi PO duyệt.
PROGRESS_ROLLUP_MODE=average
EXECUTION_LOG_EDIT_WINDOW_HOURS=72

LOG_LEVEL=info
