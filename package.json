{
  "name": "boc-control-tower",
  "version": "0.1.0",
  "private": true,
  "description": "Trung tâm Điều hành Công việc BOC — Công ty Cổ phần Văn phòng phẩm Hồng Hà",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:nixpacks": "npm run build && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "start:nixpacks": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --tsconfig tsconfig.scripts.json scripts/seed.ts",
    "extract:sheet": "tsx --tsconfig tsconfig.scripts.json scripts/extract-sheet.ts",
    "check:appwrite": "tsx --tsconfig tsconfig.scripts.json scripts/check-connection.ts",
    "bootstrap:appwrite": "tsx --tsconfig tsconfig.scripts.json scripts/bootstrap-appwrite.ts",
    "verify:schema": "tsx --tsconfig tsconfig.scripts.json scripts/verify-schema.ts",
    "import:dry-run": "tsx --tsconfig tsconfig.scripts.json scripts/import-google-sheet.ts --dry-run",
    "import:production": "tsx --tsconfig tsconfig.scripts.json scripts/import-google-sheet.ts",
    "verify:all": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "node-appwrite": "^27.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "undici": "^6.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
